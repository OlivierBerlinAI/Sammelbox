{
  "$schema": "https://schema.tauri.app/capability/0.9.0/schema.json",
  "identifier": "default",
  "description": "Default capabilities for Sammelbox",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-open",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:default",
    "sql:default",
    "sql:allow-load",
    "sql:allow-execute",
    "sql:allow-select"
  ]
}
