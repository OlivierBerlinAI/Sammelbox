{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sammelbox Modern",
  "version": "0.1.0",
  "identifier": "org.sammelbox.modern",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Sammelbox Modern - Tech Demo",
        "width": 1000,
        "height": 700,
        "minWidth": 600,
        "minHeight": 400,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: https://asset.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:demo.db"]
    }
  }
}
